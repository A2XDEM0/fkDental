{
  "name": "dental-clinic-manager",
  "private": true,
  "version": "1.4.0",
  "license": "AGPL-3.0-only",
  "description": "DentalSystem 口腔诊所管理系统",
  "author": {
    "name": "SlxBYR",
    "email": "rnfmabj007@163.com"
  },
  "homepage": "https://github.com/A2XDEM0/fkDental",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_START_URL=http://localhost:3000 electron .\"",
    "electron:build": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package": "bash scripts/package-tui.sh",
    "package:windows": "bash scripts/package-tui.sh --windows",
    "package:macos": "bash scripts/package-tui.sh --macos",
    "package:macos:intel": "bash scripts/package-tui.sh --macos-intel",
    "package:linux": "bash scripts/package-tui.sh --linux",
    "windows:uninstall-helper": "scripts/maintenance/windows-uninstall-dentalsystem.cmd"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "dicom-parser": "^1.8.21",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18",
    "tiny-pinyin": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.dental.clinic",
    "productName": "DentalSystem",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron-main.js",
      "preload.cjs",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "differentialPackage": false,
      "perMachine": false
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "scripts/maintenance/windows-uninstall-dentalsystem.cmd",
          "to": "maintenance/DentalSystem-Uninstall-Helper.cmd"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.medical",
      "artifactName": "DentalSystem-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "SlxBYR <rnfmabj007@163.com>",
      "vendor": "DentalSystem",
      "synopsis": "口腔诊所患者、处置和预约管理系统",
      "artifactName": "DentalSystem-${version}-${arch}.${ext}"
    }
  }
}
